# Copy to .env (never commit .env) or set these in Vercel → Project → Settings → Environment Variables.

# Long random string. Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Neon Postgres connection string. Leave unset locally to use a SQLite file in instance/.
# DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Optional
# APP_NAME=Clinic Manager
# TIMEZONE=Asia/Kolkata
